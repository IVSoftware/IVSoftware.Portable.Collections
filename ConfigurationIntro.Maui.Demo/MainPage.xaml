<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ConfigurationIntro.Maui.Demo.MainPage"
    xmlns:op="clr-namespace:OPC.Preview.Maui.Resources.Styles;assembly=OPC.Preview.Maui"
    xmlns:opc="clr-namespace:OPC.Preview.Maui.Controls;assembly=OPC.Preview.Maui"
    Shell.NavBarIsVisible="false">
    <ContentPage.Resources>
        <Style TargetType="Button" x:Key="CommandBarButton">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="White" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="Aqua" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
        <Label 
            Text="Interact with command bar below to demonstrate."
            TextColor="#444444"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            VerticalTextAlignment="Center"
            HorizontalTextAlignment="Center"/>
        <opc:CommandBar
            x:Name="CommandBar"
            Grid.Row="1"
            HeightRequest="{OnPlatform WinUI=40, Android=50, iOS=50, MacCatalyst=50}"
            BackgroundColor="#444444"
            ChildStyle="{StaticResource CommandBarButton}"
            VerticalOptions="End"/>
        <opc:InfoOverlay 
            x:Name="InfoOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"/>
    </Grid>

</ContentPage>
