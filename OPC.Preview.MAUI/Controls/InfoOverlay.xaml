<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Name="@this"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"    
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"    
    x:Class="OPC.Preview.Maui.Controls.InfoOverlay"
    xmlns:opc="clr-namespace:OPC.Preview.Maui.Controls"
    xmlns:gp="clr-namespace:IVSoftware.Portable;assembly=IVSoftware.GlyphProvider.Portable"
    xmlns:conv="clr-namespace:OPC.Preview.Maui.Converters">
    <ContentView.Resources>        
        <!-- Header -->
        <DataTemplate x:Key="InfoHeaderTemplate">
            <Label                
                Text="{Binding Text}"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#455A64"
                LineBreakMode="WordWrap">
                <Label.Margin>
                    <OnPlatform x:TypeArguments="Thickness">
                        <!-- WinUI: optical alignment correction for font weight metrics -->
                        <On Platform="WinUI" Value="2,10,0,20" />
                        <On Platform="Default" Value="0,10,0,20" />
                    </OnPlatform>
                </Label.Margin>
            </Label>
        </DataTemplate>

        <!-- Plain text -->
        <DataTemplate x:Key="InfoTextTemplate">
            <Label
                Text="{Binding Text}"
                FontSize="15"
                TextColor="#455A64"
                LineBreakMode="WordWrap">
                <Label.Margin>
                    <OnPlatform x:TypeArguments="Thickness">
                        <!-- WinUI: optical alignment correction for font weight metrics -->
                        <On Platform="WinUI" Value="-2,10,20,10" />
                        <On Platform="Default" Value="0,10,20,10" />
                    </OnPlatform>
                </Label.Margin>
            </Label>
        </DataTemplate>

        <!-- Separator -->
        <DataTemplate x:Key="InfoSeparatorTemplate">
            <BoxView HeightRequest="6" Opacity="0"/>
        </DataTemplate>

        <!-- Bullet -->
        <DataTemplate x:Key="InfoBulletTemplate">
            <Grid
                ColumnDefinitions="Auto,*">
                <Label
                    Grid.Column="0"
                    Text="•"
                    Margin="14,8,0,0"
                    Padding="0"
                    FontSize="18"
                    VerticalTextAlignment="Start"
                    HorizontalTextAlignment="Start"/>
                <Label
                    Grid.Column="1"
                    Margin="10,10,20,10"
                    Text="{Binding Text}"
                    FontSize="14"
                    LineBreakMode="WordWrap"/>
            </Grid>
        </DataTemplate>

        <!-- Selector -->
        <conv:InfoTextRowTemplateSelector
            x:Key="InfoRowTemplateSelector"
            HeaderTemplate="{StaticResource InfoHeaderTemplate}"
            TextTemplate="{StaticResource InfoTextTemplate}"
            BulletTemplate="{StaticResource InfoBulletTemplate}"
            SeparatorTemplate="{StaticResource InfoSeparatorTemplate}" />

    </ContentView.Resources>

    <Grid>
        <Grid.Resources>
            <Style x:Key="DSATextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#444444" />
                <Setter Property="HorizontalOptions" Value="End" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid
            Grid.RowSpan="3"
            Opacity="0.5"
            BackgroundColor="#222222">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped" />
            </Grid.GestureRecognizers>
        </Grid>
        <Border 
            Style="{StaticResource ModalContentBackgroundStyle}">
            <Grid RowDefinitions="*,Auto">
                <Grid RowDefinitions="*,20">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOverlayTapped" />
                    </Grid.GestureRecognizers>
                    <Grid
                        InputTransparent="True"
                        ColumnDefinitions="Auto,*"
                        VerticalOptions="Center"
                        ColumnSpacing="10">
                        <Label
                            Grid.Column="0"
                            Text="ℹ️"
                            Margin="2,0,4,0"
                            FontSize="Medium"
                            VerticalOptions="Center"/>
                        <CollectionView
                            Grid.Column="1"
                            ItemsSource="{Binding Rows, Source={x:Reference @this}}"
                            SelectionMode="None"
                            VerticalOptions="Center"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemTemplate="{StaticResource InfoRowTemplateSelector}" />
                    </Grid>

                    <Label
                        Grid.Row="1" 
                        Margin="2,0"
                        HeightRequest="0.75" 
                        VerticalOptions="Center"
                        BackgroundColor="#444444" />
                </Grid>
                <Grid
                    x:Name="DSAOptions"
                    Grid.Row="1"
                    VerticalOptions="Center" 
                    HorizontalOptions="Fill"
                    ColumnDefinitions="*,30">
                    <Label 
                        Margin="10,5"
                        Text="Don't show this message again."
                        FontSize="12"            
                        HorizontalTextAlignment="End"    
                        Style="{StaticResource DSATextStyle}"/>
                    <Label
                        x:Name="labelDSA"
                        Grid.Column="1"
                        Margin="10,5,2,0"
                        FontSize="16" 
                        FontFamily="icon-basics"
                        Text="&#xE80A;"
                        BackgroundColor="Transparent"   
                        HorizontalTextAlignment="End"             
                        Style="{StaticResource DSATextStyle}" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleDSA" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
