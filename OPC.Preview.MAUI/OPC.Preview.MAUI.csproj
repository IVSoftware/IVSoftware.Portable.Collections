	  </MauiXaml>
	  <MauiXaml Update="Views\StringView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <MauiFont Include="Resources\Fonts\icon-basics\font\icon-basics.ttf" />
	  <MauiFont Include="Resources\Fonts\icon-radio\font\icon-radio.ttf" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Templates\" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\ItemCardView.xaml.cs">
	    <DependentUpon>ItemCardView.xaml</DependentUpon>
