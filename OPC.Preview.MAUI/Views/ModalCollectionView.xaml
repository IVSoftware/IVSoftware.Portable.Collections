<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    x:Name="@this"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="OPC.Preview.Maui.Views.ModalCollectionView"
    xmlns:opc="clr-namespace:OPC.Preview.Maui.Controls;assembly=OPC.Preview.Maui"
    xmlns:opv="clr-namespace:OPC.Preview.Maui.Views;assembly=OPC.Preview.Maui"
    xmlns:conv="clr-namespace:OPC.Preview.Maui.Converters;assembly=OPC.Preview.Maui">
    <Grid>
        <opv:OverlayView Tapped="OnOverlayTapped"/>
        <Border
            VerticalOptions="Center"
            Style="{StaticResource ModalContentBackgroundStyle}">
            <opv:ConfigurableCollectionView
                x:Name="CollectionViewInternal"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                Margin="25,0"
                MinimumHeightRequest="25"
                BackgroundColor="Transparent"
                ItemsSource="{Binding 
                    Items, 
                    Source={x:Reference @this} }" 
                ClickableEventCommand="{Binding 
                    ClickableEventCommand, 
                    Source={x:Reference @this} }" />
        </Border>      
    </Grid>
</ContentView>
