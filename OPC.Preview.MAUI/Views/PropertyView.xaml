<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pcl="clr-namespace:OPC.Preview.Maui.Views;assembly=OPC.Preview.Maui"
    xmlns:opc="clr-namespace:OPC.Preview.Maui.Controls;assembly=OPC.Preview.Maui"
    xmlns:opv="clr-namespace:OPC.Preview.Maui.Views;assembly=OPC.Preview.Maui"
    xmlns:opcl="clr-namespace:OPC.Preview.Portable;assembly=OPC.Preview.Portable"
    x:Class="OPC.Preview.Maui.Views.PropertyView">
    <Grid
        ColumnDefinitions="Auto,*">
        <Label 
            Padding="5"
            Text="{Binding Key}"
            VerticalTextAlignment="Center"
            MinimumWidthRequest="100"/>
        <opc:EntryBase 
            x:Name="Entry"
            Grid.Column="1" 
            FontSize="15"
            Margin="1"
            Placeholder="Value"
            PlaceholderColor="LightSeaGreen"
            Text="{Binding Value}" />
    </Grid>
</ContentView>
