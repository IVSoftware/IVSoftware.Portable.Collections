<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Name="@this"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:opc="clr-namespace:OPC.Preview.Maui.Controls;assembly=OPC.Preview.Maui"
    xmlns:opv="clr-namespace:OPC.Preview.Maui.Views;assembly=OPC.Preview.Maui"
    x:Class="OPC.Preview.Maui.Views.GroupBoxView">
    <Grid
        Padding="0,20">
        <Border
            StrokeThickness="1"
            Stroke="Black"
            StrokeShape="RoundRectangle 6"
            Margin="10,10"
            Padding="8,18">
            <CollectionView
                ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <opv:GroupBoxItemView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
        <!--Override styled text color-->
        <Label
            x:Name="GroupLabel"
            Margin="20,0"
            Text="{Binding GroupName}"
            TextColor="#222222"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Padding="5,0"
            BackgroundColor="{Binding 
                EffectiveBackgroundColor,
                Source={x:Reference @this}
            }"/>
    </Grid>
</ContentView>
