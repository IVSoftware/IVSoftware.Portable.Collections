<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Single TFM. MAUI is NOT activated here. -->
		<TargetFramework>net8.0-windows</TargetFramework>

		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- WinForms support (STA tests rely on this). -->
		<UseWindowsForms>true</UseWindowsForms>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<!-- Do NOT set <UseMaui>true>. That would force the MAUI SDK. -->
		<!-- Do NOT set <UseWPF>true> unless you actually need WPF runners. -->
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<!-- Bring in MAUI *type metadata* without MAUI workload activation. -->
		<PackageReference Include="IVSoftware.Portable.Common" Version="1.0.0-beta" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />

		<!-- IVSoftware packages. -->
		<PackageReference Include="IVSoftware.Portable.Disposable" Version="2.0.0-*" />
		<PackageReference Include="IVSoftware.Portable.Threading" Version="2.0.0-*" />
		<PackageReference Include="IVSoftware.WinOS.MSTest.Extensions" Version="1.0.8" />
		<PackageReference Include="IVSoftware.WinOS.MSTest.Extensions.STA" Version="1.0.0-beta" />
		<PackageReference Include="IVSoftware.Portable.SQLiteMarkdown" Version="1.0.2-rc" />

		<!-- The MSTest toolchain. -->
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
		<PackageReference Include="MSTest" Version="4.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\IVSoftware.Portable.Collections\IVSoftware.Portable.Collections.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>

</Project>
